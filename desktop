bindNavigation();
bindForms();
bindTableActions();
bindUtilityActions();
loadState();

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Plataforma de Gestao Escolar</title>
  <link rel="stylesheet" href="./styles.css" />
</head>
<body>
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">GE</span>
      <div>
        <strong>Gestao Escolar</strong>
        <small>Versao desktop</small>
      </div>
    </div>

    <nav class="nav" aria-label="Navegacao principal">
      <button class="nav-item active" data-view="dashboard">Painel</button>
      <button class="nav-item" data-view="alunos">Alunos</button>
      <button class="nav-item" data-view="disciplinas">Disciplinas</button>
      <button class="nav-item" data-view="professores">Professores</button>
      <button class="nav-item" data-view="matriculas">Matriculas</button>
      <button class="nav-item" data-view="notas">Notas</button>
      <button class="nav-item" data-view="boletim">Boletim</button>
    </nav>
  </aside>

  <main class="app">
    <header class="topbar">
      <div>
        <p class="eyebrow">Plataforma de Gestao Escolar</p>
        <h1 id="pageTitle">Painel</h1>
      </div>
      <div class="topbar-actions">
        <button class="secondary" id="seedButton" type="button">Dados exemplo</button>
        <button class="danger" id="resetButton" type="button">Limpar dados</button>
      </div>
    </header>

    <section class="view active" id="dashboard">
      <div class="metrics">
        <article class="metric"><span>Alunos</span><strong id="metricAlunos">0</strong></article>
        <article class="metric"><span>Disciplinas</span><strong id="metricDisciplinas">0</strong></article>
        <article class="metric"><span>Professores</span><strong id="metricProfessores">0</strong></article>
        <article class="metric"><span>Matriculas</span><strong id="metricMatriculas">0</strong></article>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h2>Resumo academico</h2>
          <span id="metricNotas">0 notas lancadas</span>
        </div>
        <div class="summary-grid">
          <div><span class="summary-label">Media geral</span><strong id="metricMedia">-</strong></div>
          <div><span class="summary-label">Alunos com boletim</span><strong id="metricBoletins">0</strong></div>
          <div><span class="summary-label">Disciplinas sem professor</span><strong id="metricSemProfessor">0</strong></div>
        </div>
      </div>
    </section>

    <section class="view" id="alunos">
      <div class="layout">
        <form class="panel form" id="formAluno">
          <h2>Cadastro de aluno</h2>
          <input type="hidden" id="alunoId" />
          <label>Nome<input id="alunoNome" type="text" required /></label>
